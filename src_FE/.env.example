# Base URL of the authoritative backend API.
# Empty string => same-origin "/api". Real API mode needs a configured proxy
# or an absolute API URL, e.g. http://127.0.0.1:8000; allow Vite origin in CORS.
# No .env file is needed for the default standalone FE demo.
VITE_API_BASE_URL=

# Mock Service Worker is ON by default in development so a fresh clone renders
# real screens without a backend. Set to "false" to hit a real API instead.
# It is compiled out of production builds regardless of this value.
VITE_ENABLE_MSW=true
